# Bodhi Homeopathy - Environment Configuration Template
# Instructions: Copy this file to .env and fill in your actual credentials.
# NEVER commit the real .env file containing live secrets to version control.

# Database Settings (Local WAMP Defaults)
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=bodhi

# Application Base URL
BASE_URL=http://localhost/bodhi/
APP_URL=http://localhost/bodhi

# Gmail SMTP Settings (PHPMailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Bodhi Homeopathy
SMTP_TEST_MODE=false

# Cashfree Payment Gateway Settings (Sandbox)
CASHFREE_MODE=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2025-01-01
