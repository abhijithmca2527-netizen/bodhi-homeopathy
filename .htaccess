# ==============================================================================
# BODHI HOMEOPATHY — APACHE CONFIGURATION & CLEAN URL ROUTING
# ==============================================================================

# 1. Protect Sensitive Files & Backups from Direct HTTP Access
<FilesMatch "^\.env|\.sql$|\.log$|\.bak$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 2. Prevent Directory Browsing & Set Defaults
Options -Indexes
AddDefaultCharset UTF-8

# 3. URL Rewriting Engine (Modular Routing with Query String Preservation)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /bodhi/

    # --------------------------------------------------------------------------
    # Authentication & Password Recovery Routes
    # --------------------------------------------------------------------------
    RewriteRule ^login\.php$ auth/login.php [L,QSA]
    RewriteRule ^register\.php$ auth/register.php [L,QSA]
    RewriteRule ^logout\.php$ auth/logout.php [L,QSA]
    RewriteRule ^forgot_password\.php$ auth/forgot_password.php [L,QSA]
    RewriteRule ^reset_password\.php$ auth/reset_password.php [L,QSA]

    # --------------------------------------------------------------------------
    # Patient Portal Routes
    # --------------------------------------------------------------------------
    RewriteRule ^profile\.php$ patient/profile.php [L,QSA]
    RewriteRule ^bookings\.php$ patient/bookings.php [L,QSA]
    RewriteRule ^my_orders\.php$ patient/my_orders.php [L,QSA]
    RewriteRule ^appointment_success\.php$ patient/appointment_success.php [L,QSA]

    # --------------------------------------------------------------------------
    # Pharmacy / Storefront Routes
    # --------------------------------------------------------------------------
    RewriteRule ^products\.php$ shop/products.php [L,QSA]
    RewriteRule ^product_details\.php$ shop/product_details.php [L,QSA]
    RewriteRule ^cart\.php$ shop/cart.php [L,QSA]
    RewriteRule ^checkout\.php$ shop/checkout.php [L,QSA]
    RewriteRule ^order_details\.php$ shop/order_details.php [L,QSA]
    RewriteRule ^order_success\.php$ shop/order_success.php [L,QSA]

    # --------------------------------------------------------------------------
    # Cashfree Payment Gateway Routes
    # --------------------------------------------------------------------------
    RewriteRule ^payment\.php$ payments/payment.php [L,QSA]
    RewriteRule ^payment_return\.php$ payments/payment_return.php [L,QSA]
    RewriteRule ^payment_verify\.php$ payments/payment_verify.php [L,QSA]
    RewriteRule ^cashfree_webhook\.php$ payments/cashfree_webhook.php [L,QSA]

    # --------------------------------------------------------------------------
    # Action Handlers
    # --------------------------------------------------------------------------
    RewriteRule ^cart_action\.php$ actions/cart_action.php [L,QSA]
    RewriteRule ^place_order\.php$ actions/place_order.php [L,QSA]
    RewriteRule ^save_appointment\.php$ actions/save_appointment.php [L,QSA]
    RewriteRule ^cancel_appointment\.php$ actions/cancel_appointment.php [L,QSA]
</IfModule>
